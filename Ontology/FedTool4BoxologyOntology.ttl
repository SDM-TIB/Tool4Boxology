@prefix : <http://fedTool4boxology.org/FedTool4BoxologyOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://fedTool4boxology.org/FedTool4BoxologyOntology> .
@prefix t4b: <http://tool4boxology.org/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix orkgc: <http://orkg.org/class/> .
@prefix orkgp: <http://orkg.org/predicate/> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix schema: <http://schema.org/> .

<http://fedTool4boxology.org/FedTool4BoxologyOntology> rdf:type owl:Ontology .


# Classes

<http://orkg.org/class/Paper> rdf:type owl:Class .

<http://orkg.org/class/Author> rdf:type owl:Class .

<http://orkg.org/class/Contribution> rdf:type owl:Class .

<http://orkg.org/class/ResearchField> rdf:type owl:Class .

<http://orkg.org/class/Observatory> rdf:type owl:Class . # ?

<http://orkg.org/class/Venue> rdf:type owl:Class .

<http://fedTool4boxology.org/Evaluation> rdf:type owl:Class .

<http://www.w3.org/ns/dcat#Dataset> rdf:type owl:Class .

<http://www.w3.org/ns/dcat#Distribution> rdf:type owl:Class .

<http://www.w3.org/2006/vcard/ns#Organization> rdf:type owl:Class .

<http://purl.org/spar/pro/Author> rdf:type owl:Class ;
                                    owl:sameAS <http://orkg.org/class/Author> .

<@prefix skos: <http://www.w3.org/2004/02/skos/core#Concept> .> rdf:type owl:Class .

<http://fedTool4boxology.org/ORCID> rdf:type owl:Class .

# Datatype Properties for ORKG Papers

# use rdfs:label instead
