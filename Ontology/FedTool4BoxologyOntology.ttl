#                                    rdfs:range xsd:string .

<http://orkg.org/predicate/P26> rdf:type owl:DatatypeProperty ; # doi
                                    rdfs:domain <http://orkg.org/class/Paper> ;
                                    rdfs:range xsd:string .

<http://orkg.org/predicate/P28> rdf:type owl:DatatypeProperty ; # publication_month
                                                rdfs:domain <http://orkg.org/class/Paper> ;
                                                rdfs:range xsd:int .

<http://orkg.org/predicate/P29> rdf:type owl:DatatypeProperty ; # publication_year
                                                rdfs:domain <http://orkg.org/class/Paper> ;
                                                rdfs:range xsd:int .                                

<http://orkg.org/predicate/url> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <http://orkg.org/class/Paper> ;
                                                rdfs:range xsd:string .

