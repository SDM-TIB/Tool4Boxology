@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix t4b: <http://tool4boxology.org/> .
@prefix ft4b: <http://fedTool4boxology.org/> .
@prefix orkgc: <http://orkg.org/class/> .
@prefix orkgp: <http://orkg.org/predicate/> .
@base <http://tib.de/SDM-RDFizer/mapping#> .


<PapersMap>	a rr:TriplesMap;
	rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*]"
						];
	rr:subjectMap [
		rr:template "http://orkg.org/papers/{id}"; # "http://orkg.org/class/Paper/{id}"
		rr:class orkgc:Paper
	];
	rr:predicateObjectMap [
		rr:predicate rdfs:label; # title
		rr:objectMap [
			rml:reference "title"
		]
	];	
    rr:predicateObjectMap [
		rr:predicate orkgp:P26; # doi
		rr:objectMap [
			rml:reference "identifiers.doi[*]"
		]
	];	
    rr:predicateObjectMap [
		rr:predicate orkgp:P28; # publication_month
		rr:objectMap [
			rml:reference "publication_info.published_month";
            rr:datatype xsd:int
		]
	];	
    rr:predicateObjectMap [
		rr:predicate orkgp:P29; # publication_year
		rr:objectMap [
			rml:reference "publication_info.published_year";
            rr:datatype xsd:int
		]
	];	
    rr:predicateObjectMap [
		rr:predicate orkgp:HAS_VENUE; # publishedIn
		rr:objectMap [
			rr:template "http://orkg.org/venues/{publication_info.published_in.id}"; # "http://orkg.org/class/Venue/{publication_info.published_in.id}"
		]
	];	
    rr:predicateObjectMap [
		rr:predicate orkgp:url;
		rr:objectMap [
			rml:reference "publication_info.url"
		]
	];	
    #rr:predicateObjectMap [
	#	rr:predicate ft4b:extraction_method;
	#	rr:objectMap [
	#		rml:reference "extraction_method"
	#	]
	#];	
    #rr:predicateObjectMap [
	#	rr:predicate ft4b:sdg;
	#	rr:objectMap [
	#		rml:template "https://orkg.org/sustainable-development-goals/{sdgs[*]}" # "sdgs[*]"
	#	]
	#];	
	rr:predicateObjectMap [
		rr:predicate orkgp:P6; # author
		rr:objectMap [ 
			rr:template "http://orkg.org/authors/{authors[*].id}"; # "http://orkg.org/class/Author/{authors[*].id}"
		]
	];
	rr:predicateObjectMap [
		rr:predicate orkgp:P30; # research_field
		rr:objectMap [ 
			rr:template "http://orkg.org/fields/{research_fields[*].id}"; # "http://orkg.org/class/ResearchField/{research_fields[*].id}"
		]
	];
	rr:predicateObjectMap [
		rr:predicate orkgp:P31; # contribution
		rr:objectMap [ 
			rr:template "http://orkg.org/resources/{contributions[*].id}"; # "http://orkg.org/class/Contribution/{contributions[*].id}"
		]
	];
    rr:predicateObjectMap [
		rr:predicate ft4b:belongsToObservatory;
		rr:objectMap [ 
			rr:template "http://orkg.org/observatories/{observatories[*]}"; # "http://orkg.org/class/Observatory/{observatories[*]}"
		]
	];
    rr:predicateObjectMap [
		rr:predicate ft4b:belongsToOrganization;
		rr:objectMap [ 
			rr:template "http://orkg.org/organization/{organizations[*]}"; # "http://orkg.org/class/Organization/{organizations[*]}"
		]
	].

<AuthorsMap> a rr:TriplesMap;
    rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*].authors[*]"
						];
    rr:subjectMap [
		rr:template "http://orkg.org/authors/{id}"; # "http://orkg.org/class/Author/{id}"
