    	]
  	].

<ContributionsMap> a rr:TriplesMap;
    rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*].contributions[*]"
						];
    rr:subjectMap [
		rr:template "https://orkg.org/resources/{id}"; # "http://orkg.org/class/Contribution/{id}"
		rr:class orkgc:Contribution
	];
    rr:predicateObjectMap [
		rr:predicate rdfs:label;
		rr:objectMap [
			rml:reference "label"
		]
	].	

<ResearchFieldsMap> a rr:TriplesMap;
    rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*].research_fields[*]"
						];
    rr:subjectMap [
		rr:template "http://orkg.org/fields/{id}"; # "http://orkg.org/class/ResearchField/{id}"
		rr:class orkgc:ResearchField
	];
    rr:predicateObjectMap [
		rr:predicate rdfs:label;
		rr:objectMap [
			rml:reference "label"
		]
	].	

<ObservatoriesMap> a rr:TriplesMap;
	rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*]"
						];
    rr:subjectMap [
		rr:template "http://orkg.org/observatories/{observatories[*]}" ; # "http://orkg.org/class/Observatory/{observatories[*]}"
		rr:class ft4b:Observatory
	].

<OrganizationsMap> a rr:TriplesMap;
    rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*]"
						];
    rr:subjectMap [
		rr:template "http://orkg.org/organizations/General/{organizations[*]}"; # "http://orkg.org/class/Organization/{organizations[*]}"
		rr:class vcard:Organization
	].

<VenuesMap> a rr:TriplesMap;
	rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*].publication_info.published_in"
						];
    rr:subjectMap [
		rr:template "http://orkg.org/venues/{id}"; #"http://orkg.org/class/Venue/{id}"
		rr:class orkgc:Venue
	];
	rr:predicateObjectMap [
		rr:predicate rdfs:label;
		rr:objectMap [
			rml:reference "label"
		]
	].

<EvaluationsMap> a rr:TriplesMap;
	rml:logicalSource [ rml:source "C:/Users/simon/OneDrive/Uni/Veranstaltungen/Semester 8/Bachelorarbeit/ttl/data/papers.json";
						rml:referenceFormulation ql:JSONPath;
						rml:iterator "$.papers[*]."
						];
	rr:subjectMap [
		rr:template "http://fedTool4boxology.org/Evaluation/{id}"; 
		rr:class ft4b:Evaluation
	];
	rr:predicateObjectMap [
    	rr:predicate ft4b:evaluatesPaper;
    	rr:objectMap [
      		rr:parentTriplesMap <PapersMap>;
			rr:joinCondition [
				rr:child "id";
				rr:parent "id"
			] 
    	]
  	#];
	#rr:predicateObjectMap [
    #	rr:predicate ft4b:evaluatesDataset;
