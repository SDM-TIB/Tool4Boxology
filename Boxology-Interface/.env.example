# Copy to .env and fill in - .env is gitignored and read by docker-compose.yml.

# Bearer token for the T4B Modal GPU endpoint (modal_app/serve.py). Matches the
# T4B_MODAL_API_KEY value stored in the Modal secret "t4b-llama-api-key".
# Only the site operator needs this - end users never see or enter it.
MODAL_T4B_API_KEY=

# Agents workflow: selected adapter proposes; separate instruction model builds.
T4B_GENERATION_WORKFLOW=agents
T4B_BUILDER_PROVIDER=gemini
T4B_BUILDER_MODEL=gemini-3.5-flash-lite
T4B_BUILDER_API_KEY=
T4B_BUILDER_TIMEOUT_SECONDS=180
# Offline builder defaults to Qwen2.5-7B Q4_K_M (~4.7 GB, downloaded once).
# Override with an existing GGUF file (container-visible path for Docker):
# T4B_LOCAL_BUILDER_PATH=/data/models/instruction-model.gguf

# Full skill plus output and a bounded repair transcript.
T4B_LOCAL_N_CTX=16384
T4B_PLAN_MAX_TOKENS=6144
T4B_PLAN_ATTEMPTS=3
MODAL_REQUEST_TIMEOUT_SECONDS=300
# Optional URLs printed by modal deploy modal_app/serve.py:
# MODAL_T4B_CHAT_URL=https://...-chat...modal.run
# MODAL_T4B_HEALTH_URL=https://...-health...modal.run
# Docker-visible directory containing baseline.gguf, cot2.gguf, cot3.gguf:
# T4B_LOCAL_ADAPTERS_DIR=/app/training/architecture_plans/gguf_adapters

# Shared Modal rate limit (backend/main.py's _check_modal_rate_limit). Defaults
# to 5/hour per IP and 50/day total - sized for a public demo where the site
# operator is paying for every caller's GPU time. During local development all
# of your own testing counts as one IP. Agents mode uses one Modal advisor call
# per diagram; builder repairs use the separate provider's quota. Direct research
# mode can use three Modal calls per diagram.
# Raise these for your own dev/test use; leave unset (uses the safe defaults)
# for a public-facing deployment.
# MODAL_RATE_LIMIT_PER_IP_PER_HOUR=50
# MODAL_RATE_LIMIT_GLOBAL_PER_DAY=200
