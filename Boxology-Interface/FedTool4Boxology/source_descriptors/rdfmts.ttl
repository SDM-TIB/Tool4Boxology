            semsd:hasSource <http://boxology_kg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
            rdfs:range <http://tool4boxology.org/StatisticalModel> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
            rdfs:range <http://tool4boxology.org/Classes> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
            rdfs:range <http://tool4boxology.org/Number> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
