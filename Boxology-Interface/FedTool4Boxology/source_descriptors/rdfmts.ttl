dcat:Dataset a rdfs:Class ;
    semsd:hasProperty dcterms:creator,
        dcterms:description,
        dcterms:identifier,
        dcterms:issued,
        dcterms:license,
        dcterms:modified,
        dcterms:publisher,
        dcterms:source,
        dcterms:title,
        <http://purl.org/spar/datacite/isDescribedBy>,
        rdf:type,
        dcat:distribution,
        dcat:keyword,
        dcat:landingPage ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

dcat:Distribution a rdfs:Class ;
    semsd:hasProperty dcterms:description,
        dcterms:format,
        dcterms:issued,
        dcterms:language,
        dcterms:modified,
        dcterms:title,
        rdf:type,
        dcat:accessURL,
        dcat:byteSize,
        dcat:downloadURL,
        dcat:mediaType ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://fedTool4boxology.org/belongsToObservatory> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://fedTool4boxology.org/belongsToOrganization> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://fedTool4boxology.org/evaluatesBoxology> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://fedTool4boxology.org/evaluatesDataset> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain <http://fedTool4boxology.org/Evaluation> ;
            rdfs:range dcat:Dataset ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

<http://fedTool4boxology.org/evaluatesPaper> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain <http://fedTool4boxology.org/Evaluation> ;
            rdfs:range <http://orkg.org/class/Paper> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

<http://fedTool4boxology.org/hasBenchmark> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain <http://orkg.org/class/Paper> ;
            rdfs:range dcat:Dataset ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

<http://fedTool4boxology.org/hasBoxology> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/predicate/HAS_VENUE> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain <http://orkg.org/class/Paper> ;
            rdfs:range <http://orkg.org/class/Venue> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

<http://orkg.org/predicate/P26> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/predicate/P28> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/predicate/P29> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/predicate/P30> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain <http://orkg.org/class/Paper> ;
            rdfs:range <http://orkg.org/class/ResearchField> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

<http://orkg.org/predicate/P31> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/predicate/P6> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/predicate/url> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

dcterms:creator a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain dcat:Dataset ;
            rdfs:range <http://purl.org/spar/pro/Author> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

dcterms:format a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

dcterms:identifier a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

dcterms:language a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

dcterms:license a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

dcterms:publisher a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain dcat:Dataset ;
            rdfs:range <http://www.w3.org/2006/vcard/ns#Organization> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

dcterms:source a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://purl.org/spar/datacite/isDescribedBy> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://purl.org/spar/pro/authorOf> a rdf:Property ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> ;
    semsd:propertyRange [ a semsd:PropertyRange ;
            rdfs:domain <http://purl.org/spar/pro/Author> ;
            rdfs:range dcat:Dataset ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ] .

<http://purl.org/spar/pro/owner> a rdf:Property ;
