            semsd:hasSource <http://boxology_kg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
            rdfs:range <http://tool4boxology.org/Rules> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
            rdfs:range <http://tool4boxology.org/Text> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
            rdfs:range <http://tool4boxology.org/KG> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
            rdfs:range <http://tool4boxology.org/HybridModel> ;
            semsd:hasSource <http://ft4bkg:8890/sparql/> ],
        [ a semsd:PropertyRange ;
            rdfs:domain <http://tool4boxology.org/DesignPattern> ;
