@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semsd: <https://research.tib.eu/semantic-source-description#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://fedTool4boxology.org/Evaluation> a rdfs:Class ;
    semsd:hasProperty <http://fedTool4boxology.org/evaluatesBoxology>,
        <http://fedTool4boxology.org/evaluatesDataset>,
        <http://fedTool4boxology.org/evaluatesPaper>,
        rdf:type ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/class/Author> a rdfs:Class ;
    semsd:hasProperty rdf:type,
        rdfs:label ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/class/Contribution> a rdfs:Class ;
    semsd:hasProperty rdf:type,
        rdfs:label ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/class/Paper> a rdfs:Class ;
    semsd:hasProperty <http://fedTool4boxology.org/belongsToObservatory>,
        <http://fedTool4boxology.org/belongsToOrganization>,
        <http://fedTool4boxology.org/hasBenchmark>,
        <http://fedTool4boxology.org/hasBoxology>,
        <http://orkg.org/predicate/HAS_VENUE>,
        <http://orkg.org/predicate/P26>,
        <http://orkg.org/predicate/P28>,
        <http://orkg.org/predicate/P29>,
        <http://orkg.org/predicate/P30>,
        <http://orkg.org/predicate/P31>,
        <http://orkg.org/predicate/P6>,
        <http://orkg.org/predicate/url>,
        rdf:type,
        rdfs:label ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/class/ResearchField> a rdfs:Class ;
    semsd:hasProperty rdf:type,
        rdfs:label ;
    semsd:hasSource <http://ft4bkg:8890/sparql/> .

<http://orkg.org/class/Venue> a rdfs:Class ;
