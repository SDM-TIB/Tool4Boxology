FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Keep npm compatible with the Node 20 image and install from the lockfile
RUN npm install -g npm@10 && npm ci

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
